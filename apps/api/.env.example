# Copia este archivo a .env para desarrollo local. En Vercel, estas mismas variables van en
# Project → Settings → Environment Variables.

# Postgres (Neon). Sin esto, en local se usa PGlite en .pglite/ y no hace falta nada más.
# De dónde: Vercel → Storage → Create → Neon (la conecta sola al proyecto).
DATABASE_URL=

# Orígenes permitidos para CORS (en Vercel web y API comparten dominio, no hace falta).
WEB_ORIGIN=http://localhost:5173

# Panel /admin
# JWT_SECRET: cualquier cadena aleatoria de 32+ caracteres → node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
ADMIN_EMAIL=
# ADMIN_PASSWORD_HASH: npm run hash-password -w apps/api -- "tu-contraseña"
ADMIN_PASSWORD_HASH=

# Traducción al guardar proyectos. De dónde: deepl.com/pro-api → plan Free → Account → API Keys
DEEPL_API_KEY=

# Aviso por correo de mensajes de contacto. De dónde: resend.com → API Keys
RESEND_API_KEY=
CONTACT_TO_EMAIL=
